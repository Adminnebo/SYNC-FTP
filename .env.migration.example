# Copy to .env.migration and fill in real values for LOCAL runs.
# In GitHub Actions these come from repo Secrets instead (see README).

# --- SFTP (Azure Blob Storage) — for `npm run sync` ---
SFTP_HOST=jheacloudservice.blob.core.windows.net
SFTP_PORT=22
SFTP_USER=your-sftp-user
SFTP_PASSWORD=your-sftp-password

# --- Supabase (SFTP destination) ---
SFTP_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SFTP_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: destination buckets (defaults shown)
# SFTP_IMAGES_BUCKET=Lucas_imagenes
# SFTP_FICHAS_BUCKET=Lucas_fichas_tecnicas
